# .env.example
#
# Copy this file to .env and populate it for local development.
# NEVER commit .env to version control — it may contain secrets.
#
# All variables use the MM_ prefix.
# Nested settings use double-underscore: MM_DATA__PROVIDERS__PRIMARY=yahoo
#
# Environment loading order (later overrides earlier):
#   1. Default values in Settings
#   2. config/environments/{MM_ENVIRONMENT}.yaml
#   3. This file (.env)
#   4. Variables set directly in the shell

# -----------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------

# Which configuration environment to use.
# Valid: local | research | test | production
MM_ENVIRONMENT=local

# -----------------------------------------------------------------------
# Optional — override environment YAML values
# -----------------------------------------------------------------------

# Logging
# MM_LOGGING__LEVEL=INFO
# MM_LOGGING__FORMAT=console

# Database
# MM_DATABASE__URL=sqlite:///./data/marketmind_local.db

# Data providers
# MM_DATA__PROVIDERS__PRIMARY=yahoo
# MM_DATA__PROVIDERS__FALLBACK=mock

# -----------------------------------------------------------------------
# API keys (if using paid data providers in a later phase)
# -----------------------------------------------------------------------

# Alpha Vantage
# MM_ALPHA_VANTAGE_API_KEY=your_key_here

# Polygon.io
# MM_POLYGON_API_KEY=your_key_here

# Finnhub
# MM_FINNHUB_API_KEY=your_key_here
